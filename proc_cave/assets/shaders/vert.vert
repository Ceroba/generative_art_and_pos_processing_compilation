#version 430 coreprecision highp float;in vec2 apos;in uint acol;in vec2 acor;out vec4 color;out vec2 coord;vec4 upackcolor(uint _color) {	float r = ((_color >> 24u) & 0xFFu) / 255.0f;	float g = ((_color >> 16u) & 0xFFu) / 255.0f;	float b = ((_color >> 8u) & 0xFFu) / 255.0f;	float a = (_color & 0xFFu) / 255.0f;	return vec4(r, g, b, a);}void main() {	gl_Position = vec4(apos, 0, 1);	color = upackcolor(acol);	coord = acor;};